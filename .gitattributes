# Keep LF in the repository for everything the Linux container runs, so a
# Windows checkout can never ship CRLF into the image.
* text=auto eol=lf

Dockerfile      text eol=lf
*.py            text eol=lf
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.xml           text eol=lf
*.md            text eol=lf

*.png           binary
*.ico           binary
